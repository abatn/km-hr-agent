# Vorlage für .env-email (E-Mail-Versand über mcp-email-server.py).
# Kopieren nach .env-email, chmod 600. Werte NIE committen oder loggen.
# Spec: knowledge/system/configuration-secrets.md §(j).

# Mailtrap Transactional-Stream (Domain hanibal-ai.com, verifiziert)
SMTP_SERVER=live.smtp.mailtrap.io
SMTP_PORT=587
# Login ist fest "api" bei Mailtrap
SMTP_USERNAME=api
# Transactional-API-Token der Domain (Passwort des Logins)
SMTP_PASSWORD=<mailtrap-transactional-token>
# Absender für Header und Envelope; muss zur verifizierten Domain gehören
SMTP_FROM=no-reply@hanibal-ai.com
DEFAULT_FROM_NAME=KM-HR-Agent
