# KM-HR-Agent – Vorlage fuer .env (NICHT committen: .env steht in .gitignore).
# Kopieren:  cp .env.example .env && chmod 600 .env   — dann Werte ersetzen.
# Erzeugen:  python3 -c 'import secrets;print(secrets.token_urlsafe(48))'
KMHR_STORAGE_SECRET=<zufaelliges-geheimnis>
KMHR_ADMIN_SEED_PASSWORD=<zufaelliges-passwort>
# optional:
# KMHR_ADMIN_SEED_EMAIL=admin@firma.example
# KMHR_PORT=8080
#
# Entgeltmodell (26.10.2026, AGB Par. 5) - nur mit ECHTEN Bankdaten aktivieren!
# Default aus; Zahlung ausschliesslich per Bankueberweisung (kein Karten-Payment).
# KMHR_BILLING_ENABLED=1
# KMHR_BANK_HOLDER=<Kontoinhaber>
# KMHR_BANK_IBAN=<IBAN>
# KMHR_BANK_NAME=<Bankname>
# KMHR_BANK_BIC=<BIC>
#
# Willkommensmail bei Registrierung (30.10.2026) - Default aus (0).
# Nur exakt "1" schaltet frei; Mailversand macht der Agent-Runner.
KMHR_WELCOME_MAIL=0
#
# Basis-URL fuer Links in Mails (Passwort-Reset, Willkommensmail).
# In Produktion die oeffentliche HTTPS-Adresse eintragen.
KMHR_PUBLIC_BASE_URL=http://localhost:8080
#
# Zustellfehler (Bounce) per IMAP-DSN, Default aus (Spec configuration-secrets.md §(i)).
# Nur exakt "1" schaltet ein. Die IMAP-Zugangsdaten (KMHR_IMAP_HOST/PORT/USER/PASSWORD/MAILBOX)
# gehoeren in .env-runner, NICHT hierher.
KMHR_BOUNCE_POLL_ENABLED=0
