# KM-HR-Agent – Vorlage fuer .env (NICHT committen: .env steht in .gitignore).
# Kopieren:  cp .env.example .env && chmod 600 .env   — dann Werte ersetzen.
# Erzeugen:  python3 -c 'import secrets;print(secrets.token_urlsafe(48))'
KMHR_STORAGE_SECRET=<zufaelliges-geheimnis>
KMHR_ADMIN_SEED_PASSWORD=<zufaelliges-passwort>
# optional:
# KMHR_ADMIN_SEED_EMAIL=admin@firma.example
# KMHR_PORT=8080
#
# Entgeltmodell (26.10.2026, AGB Par. 5) - nur mit ECHTEN Bankdaten aktivieren!
# Default aus; Zahlung ausschliesslich per Bankueberweisung (kein Karten-Payment).
# KMHR_BILLING_ENABLED=1
# KMHR_BANK_HOLDER=<Kontoinhaber>
# KMHR_BANK_IBAN=<IBAN>
# KMHR_BANK_NAME=<Bankname>
# KMHR_BANK_BIC=<BIC>
