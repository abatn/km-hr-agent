# KM-HR-Agent – Social-Media-Agent (Vorlage, NICHT committen)
# Kopieren: cp .env-social.example .env-social && chmod 600 .env-social
# Default ist Dry-Run (kein Netz, Payload in ergebnisse/social/<Tag>/).

KMHR_SOCIAL_ENABLED=1
KMHR_SOCIAL_MODE=dry_run
KMHR_SOCIAL_AUTO_PUBLISH=0
KMHR_SOCIAL_SITE_URL=https://jobs.hanibal-ai.com

# LinkedIn OAuth (Client ID + Secret + Redirect-URI in der LinkedIn-App registrieren)
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# LINKEDIN_REDIRECT_URI=https://jobs.hanibal-ai.com/oauth/callback
# LINKEDIN_SCOPES=openid profile w_member_social
# LINKEDIN_VERSION=202610
# Nach OAuth: LINKEDIN_ACCESS_TOKEN / LINKEDIN_AUTHOR_URN

# Facebook/Meta OAuth (App-ID + App-Secret; Redirect-URI in der Meta-App registrieren)
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
# FACEBOOK_REDIRECT_URI=https://jobs.hanibal-ai.com/oauth/callback
# FACEBOOK_SCOPES=pages_show_list,pages_manage_posts,pages_read_engagement
# Instagram erst nach App-Review:
# FACEBOOK_FETCH_INSTAGRAM=1
# FACEBOOK_SCOPES=pages_show_list,pages_manage_posts,pages_read_engagement,instagram_basic,instagram_content_publish
# Nach OAuth: FACEBOOK_PAGE_ID / FACEBOOK_PAGE_ACCESS_TOKEN

# Instagram (Business/Creator; public image URL required)
# INSTAGRAM_USER_ID=
# INSTAGRAM_ACCESS_TOKEN=
# INSTAGRAM_IMAGE_URL=https://jobs.hanibal-ai.com/...

# Meta-Werbeanzeigen (Facebook Ads, live nur PAUSED; siehe marketing/ads-agent.md)
# Vorabprüfung: scripts/ads_agent.py --check-meta
# META_AD_ACCOUNT_ID=act_...
# META_ADS_ACCESS_TOKEN=EAAG...          # Nutzer-Token mit ads_management
# FACEBOOK_PAGE_ID=...                   # Anzeigengeber
# META_GRAPH_VERSION=v26.0
# META_ADS_CURRENCY=EUR
# META_DSA_BENEFICIARY=Hanibal AI        # DSA-Pflicht für EU-Zielgruppe
# META_DSA_PAYOR=Hanibal AI

# Video-Ad (optional): ohne Video legt --live eine Link-Anzeige an.
# Genau eine Quelle setzen: ID (bereits hochgeladen), öffentliche URL oder lokale Datei.
# META_VIDEO_ID=
# META_VIDEO_URL=https://jobs.hanibal-ai.com/.../reel.mp4
# META_VIDEO_PATH=/pfad/zum/reel.mp4
# Pflicht bei Video: lokales Thumbnail ODER öffentliche URL
# META_VIDEO_THUMBNAIL_PATH=/pfad/zum/reel-thumb.jpg
# META_VIDEO_THUMBNAIL_URL=https://jobs.hanibal-ai.com/.../reel-thumb.jpg
