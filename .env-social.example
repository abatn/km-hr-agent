# KM-HR-Agent – Social-Media-Agent (Vorlage, NICHT committen)
# Kopieren: cp .env-social.example .env-social && chmod 600 .env-social
# Default ist Dry-Run (kein Netz, Payload in ergebnisse/social/<Tag>/).

KMHR_SOCIAL_ENABLED=1
KMHR_SOCIAL_MODE=dry_run
KMHR_SOCIAL_AUTO_PUBLISH=0
KMHR_SOCIAL_SITE_URL=https://jobs.hanibal-ai.com

# LinkedIn OAuth (Client ID + Secret + Redirect-URI in der LinkedIn-App registrieren)
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# LINKEDIN_REDIRECT_URI=https://jobs.hanibal-ai.com/oauth/callback
# LINKEDIN_SCOPES=w_member_social
# LINKEDIN_VERSION=202506
# Nach OAuth: LINKEDIN_ACCESS_TOKEN / LINKEDIN_AUTHOR_URN

# Facebook/Meta OAuth (App-ID + App-Secret; Redirect-URI in der Meta-App registrieren)
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
# FACEBOOK_REDIRECT_URI=https://jobs.hanibal-ai.com/oauth/callback
# FACEBOOK_SCOPES=pages_show_list,pages_manage_posts,pages_read_engagement,instagram_basic,instagram_content_publish
# Nach OAuth: FACEBOOK_PAGE_ID / FACEBOOK_PAGE_ACCESS_TOKEN

# Instagram (Business/Creator; public image URL required)
# INSTAGRAM_USER_ID=
# INSTAGRAM_ACCESS_TOKEN=
# INSTAGRAM_IMAGE_URL=https://jobs.hanibal-ai.com/...
